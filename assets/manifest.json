{
  "manifest_version": 3,
  "name": "Tab Stash",
  "version": "3.4",
  "description": "A no-fuss way to save and restore batches of tabs as bookmarks.",
  "homepage_url": "https://josh-berry.github.io/tab-stash/",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/logo-16.png",
    "32": "icons/logo-32.png",
    "48": "icons/logo-48.png",
    "64": "icons/logo-64.png",
    "96": "icons/logo-96.png",
    "128": "icons/logo-128.png"
  },
  "permissions": [
    "tabs",
    "bookmarks",
    "contextMenus",
    "storage",
    "unlimitedStorage",
    "alarms",
    "sidePanel"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self';"
  },
  "background": {
    "service_worker": "index.js",
    "type": "module"
  },
  "action": {
    "default_title": "Tab Stash",
    "default_icon": {
      "16": "icons/logo-16.png",
      "32": "icons/logo-32.png",
      "64": "icons/logo-64.png"
    }
  },
  "side_panel": {
    "default_path": "stash-list.html?view=side_panel"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+T",
        "mac": "MacCtrl+Shift+T"
      }
    },
    "show_side_panel": {
      "description": "Show Tab Stash in the side panel",
      "suggested_key": {
        "default": "Alt+Shift+S",
        "mac": "MacCtrl+Shift+S"
      }
    }
  }
}
